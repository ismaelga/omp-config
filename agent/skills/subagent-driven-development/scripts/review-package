#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not HEAD~1) keeps multi-commit
# tasks intact.
#
# Writes to the session's local:// payload directory when resolvable
# (subagents read the parent's local:// root by path), else to the given
# OUTFILE.
#
# Usage: review-package BASE HEAD [OUTFILE]
# Default OUTFILE: local://sdd-review-<base7>..<head7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: review-package BASE HEAD [OUTFILE]" >&2
  exit 2
fi

base=$1
head=$2

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  # omp exposes the session's local:// root to subprocesses via
  # PI_EVAL_LOCAL_ROOTS (JSON: {"local": "<path>"}). Fall back to a
  # working-tree scratch dir when running outside the harness.
  dir=""
  if [ -n "${PI_EVAL_LOCAL_ROOTS:-}" ] && command -v python3 >/dev/null 2>&1; then
    dir=$(python3 -c 'import json,os,sys; print(json.loads(os.environ["PI_EVAL_LOCAL_ROOTS"])["local"])' 2>/dev/null || true)
  fi
  if [ -z "$dir" ]; then
    root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    dir="$root/.superpowers/sdd"
  fi
  mkdir -p "$dir"
  out="$dir/sdd-review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
} > "$out"

commits=$(git rev-list --count "${base}..${head}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"