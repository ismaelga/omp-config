# Default-deny. ~/.omp holds live credentials (agent.db -> auth_credentials),
# session transcripts, blobs and caches. Only hand-written config is tracked;
# anything new is ignored until explicitly whitelisted below.
*

!.gitignore
!.gitmodules
!README.md
!LICENSE
!NOTICE
!agent/
!agent/APPEND_SYSTEM.md
!agent/AGENTS.md
!agent/RULES.md
!agent/PERSONALITY.md
!agent/WATCHDOG.md
!agent/WATCHDOG.yml
!agent/config.yml
!agent/models.yml
!agent/mcp.json
!agent/lsp.json
!agent/agents/
!agent/agents/*.md
!agent/commands/
!agent/commands/*.md
!agent/tools/
!agent/tools/**
!agent/skills/
!agent/skills/**
!agent/scripts/
!agent/scripts/*.sh
!agent/scripts/*.py
!agent/scripts/*.ts
!agent/scripts/jev/
!agent/scripts/jev/*.py
!agent/scripts/jev-ts/
!agent/scripts/jev-ts/*.ts

# Build droppings anywhere under agent/, not just skills/ — agent/tools/ grows
# __pycache__ too, and bytecode is regenerable from the tracked .py sources.
**/__pycache__/
**/*.pyc
**/.DS_Store

# Third-party binaries dropped into the tool dir. Provisioned per machine, not
# vendored: 37 MB Mach-O each, self-updating via `-U`, so every update would be
# a fresh full-size blob in history. See README "What is tracked".
agent/tools/yt-dlp
