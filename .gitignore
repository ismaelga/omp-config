# Default-deny. ~/.omp holds live credentials (agent.db -> auth_credentials),
# session transcripts, blobs and caches. Only hand-written config is tracked;
# anything new is ignored until explicitly whitelisted below.
*

!.gitignore
!README.md
!LICENSE
!agent/
!agent/AGENTS.md
!agent/RULES.md
!agent/config.yml
!agent/models.yml
!agent/mcp.json
!agent/lsp.json
!agent/agents/
!agent/agents/*.md
!agent/commands/
!agent/commands/*.md
!agent/skills/
!agent/skills/**

# Skill scratch: python bytecode, editor droppings.
agent/skills/**/__pycache__/
agent/skills/**/*.pyc
agent/skills/**/.DS_Store
